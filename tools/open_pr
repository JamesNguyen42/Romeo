#!/usr/bin/env python3
"""Push fix/<case> and open a pull request with the evidence, the check and the verification result."""
import sys, os, glob, json
from pathlib import Path; sys.path.insert(0, os.path.dirname(__file__) + "/lib")
from tool import INPUT, JOB, PRODUCT, sh, git, finish, case_rev, ornith

case, rev = INPUT["case_id"], case_rev()
branch = f"fix/{case}"
if not git("rev-parse", "--verify", "-q", branch, check=False):
    finish("No fix branch to open a pull request from", [f"Branch {branch} does not exist; write_fix has not produced a fix."], data={"error": True})
checks = sorted(glob.glob(str(JOB.parent / f"{case}-*" / "check.sh")))
check_text = open(checks[-1]).read() if checks else ""
expect = next((l.split("Passes when:", 1)[1].strip() for l in check_text.splitlines() if "Passes when:" in l), "")
facts = INPUT.get("facts", [])

# The model writes the prose in ASD-STE100 style; numbers, conditions and links are inserted verbatim by this tool.
prose, _ = ornith(
    "Write a pull request description in ASD-STE100 Simplified Technical English: short sentences (max 20 words), common words, "
    "active voice, one claim per sentence, no marketing words. Use only the facts given. Output exactly three short paragraphs "
    "with these headings on their own lines: 'Problem', 'Cause', 'Change'.",
    f"Report: {INPUT.get('report', '')}\nFacts:\n" + "\n".join(f"- {f}" for f in facts[-14:]), 500)
body = [prose.strip(), "", "## Evidence (measured by the agent on this machine)"]
body += [f"- {f}" for f in facts[-10:] if any(ch.isdigit() for ch in f)]
if expect:
    body += ["", "## Regression check", f"The check `checks/{case}.sh` runs the renderer and passes when:", "", f"```\n{expect}\n```",
             "", "It fails on the release build and passes on the known-good build."]
charts = sorted(glob.glob(str(JOB.parent / f"{case}-*" / "*.png")))
charts = [Path(c).name for c in charts if Path(c).name in ("frames.png", "trace.png", "memory.png", "render.png")]
if charts:
    body += ["", "## Evidence charts (drawn by the agent from its own runs)"]
    body += [f"![{c[:-4]}](https://github.com/{os.environ.get('PRODUCT_REPO', '')}/raw/{branch}/evidence/{case}/{c})" for c in dict.fromkeys(charts)]
body += ["", "## Verification", "The agent runs this branch again after the pull request and posts the result in the case thread.",
         "", f"Opened by Juliette, the always-on engineering agent, for case `{case}`. Every step is in the case log."]
(JOB / "pr-body.md").write_text("\n".join(body))
code, out = sh("git", "-C", str(PRODUCT), "push", "-q", "-f", "origin", branch, timeout=120)
if code != 0:
    finish("Push failed", [f"git push of {branch} failed: {out[-300:]}"], ["pr-body.md"], {"error": True})
code, out = sh("gh", "pr", "create", "--repo", os.environ.get("PRODUCT_REPO", ""), "--base", rev, "--head", branch,
               "--title", f"Fix {case}: {INPUT.get('title', 'regression')}", "--body-file", str(JOB / "pr-body.md"), cwd=str(PRODUCT), timeout=120)
url = out.strip().splitlines()[-1] if code == 0 else ""
if code != 0 and "already exists" in out:
    code, url = 0, out.strip().splitlines()[-1]
finish(f"Pull request: {url}" if code == 0 else "Pull request failed",
       [f"Opened pull request {url} from {branch} into {rev}." if code == 0 else f"gh pr create failed: {out[-300:]}"],
       ["pr-body.md"], {"pr_url": url, "error": code != 0})
