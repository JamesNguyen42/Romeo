#!/usr/bin/env python3
"""Ask Ornith for a patch, apply it on fix/<case>, build it, and run the agent-written check against it."""
import sys, os, glob, tempfile; sys.path.insert(0, os.path.dirname(__file__) + "/lib")
from pathlib import Path
from tool import INPUT, JOB, PRODUCT, sh, git, ornith, fenced, finish, build, case_rev, ref

case, rev, good = INPUT["case_id"], case_rev(), INPUT.get("rev_good", "main")
checks = sorted(glob.glob(str(JOB.parent / f"{case}-*" / "check.sh")))
check = checks[-1] if checks else None
rev, good = ref(rev), ref(good)
change = git("diff", "-U6", f"{good}...{rev}")
files = [l[6:] for l in change.splitlines() if l.startswith("+++ b/")]


def changed_regions(diff, rev, budget=9000):
    """Each changed hunk of the revision under investigation, +-30 lines, numbered. Ornith's context is 8k tokens,
    so whole files do not fit; the changed functions are what a fix needs."""
    import re
    out, current = [], None
    ranges = {}
    for line in diff.splitlines():
        if line.startswith("+++ b/"):
            current = line[6:]
        m = re.match(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", line)
        if m and current:
            start, count = int(m.group(1)), int(m.group(2) or 1)
            ranges.setdefault(current, []).append((max(1, start - 30), start + count + 30))
    for f, spans in ranges.items():
        src = git("show", f"{rev}:{f}", check=False).splitlines()
        for a, b in spans:
            block = "\n".join(f"{n:5d}  {src[n - 1]}" for n in range(a, min(b, len(src)) + 1))
            out.append(f"\n===== {f} lines {a}-{min(b, len(src))} (at {rev}) =====\n{block}")
    text = "".join(out)
    return text[:budget]


context = changed_regions(change, rev)
change = change[:5000]

branch = f"fix/{case}"
feedback, attempts = "", []
for attempt in (1, 2):
    content, reasoning = ornith(
        "You fix renderer regressions. Output one ```diff block only: a unified diff with a/ and b/ paths that applies with "
        "`git apply` on top of the given revision. Keep the patch minimal and keep the code style.",
        f"Case:\n{INPUT['case_state']}\n\nThe change that introduced the problem:\n```diff\n{change[:8000]}\n```\n"
        f"Changed regions of the current source (numbered lines):{context}\n{feedback}", 1500)
    patch = fenced(content, "diff") + "\n"
    (JOB / f"fix-{attempt}.patch").write_text(patch)
    work = Path(tempfile.mkdtemp(prefix=f"fix-{case}-"))
    git("worktree", "add", "-f", "-B", branch, str(work), rev)
    code, out = sh("git", "-C", str(work), "apply", "--recount", "--whitespace=nowarn", str(JOB / f"fix-{attempt}.patch"))
    if code != 0:  # model-written hunks often miscount lines; patch with fuzz tolerates that
        code, out = sh("patch", "-p1", "-F3", "-d", str(work), "-i", str(JOB / f"fix-{attempt}.patch"))
    if code != 0:
        attempts.append({"attempt": attempt, "applied": False, "error": out[-600:]})
        feedback = f"\nYour previous patch did not apply: {out[-600:]}\nProduce a patch against exactly the source shown."
        git("worktree", "remove", "--force", str(work), check=False)
        continue
    charts = sorted(glob.glob(str(JOB.parent / f"{case}-*" / "*.png")))
    charts = [c for c in charts if Path(c).name in ("frames.png", "trace.png", "memory.png", "render.png")]
    if charts:  # the evidence charts ship with the fix, so the pull request shows them inline
        import shutil
        (work / "evidence" / case).mkdir(parents=True, exist_ok=True)
        for c in charts:
            shutil.copy(c, work / "evidence" / case / Path(c).name)
        sh("git", "-C", str(work), "add", "evidence")
    if check:  # the regression check ships with the fix, so CI can run it without a model
        import shutil
        (work / "checks").mkdir(exist_ok=True)
        shutil.copy(check, work / "checks" / f"{case}.sh")
        shutil.copy(Path(check).parent / "runcheck.py", work / "checks" / "runcheck.py")
        sh("git", "-C", str(work), "add", "checks")
    sh("git", "-C", str(work), "-c", "user.name=Juliette agent", "-c", "user.email=juliette-agent@users.noreply.github.com",
       "commit", "-qam", f"Fix {case}: {INPUT.get('title', 'regression')}")
    fix_sha = git("rev-parse", branch)
    git("worktree", "remove", "--force", str(work), check=False)
    binary, out = build(branch)
    if not binary:
        attempts.append({"attempt": attempt, "applied": True, "built": False, "error": out[-600:]})
        feedback = f"\nYour previous patch applied but did not compile:\n{out[-1200:]}\nFix it."
        continue
    result = None
    if check:
        run_dir = JOB / f"check-on-fix-{attempt}"; run_dir.mkdir(exist_ok=True)
        result, log = sh("sh", check, binary, str(run_dir), timeout=300)
        (JOB / f"check-on-fix-{attempt}.log").write_text(log)
    attempts.append({"attempt": attempt, "applied": True, "built": True, "check_exit": result, "reasoning": reasoning[:2000]})
    if result in (0, None):
        verdict = "passes the agent-written check" if result == 0 else "builds (no check was written for this case)"
        finish(f"Patch on {branch} ({fix_sha[:8]}) {verdict}",
               [f"Wrote a fix (attempt {attempt}) on branch {branch} at {fix_sha[:8]}; it applies, builds, and {verdict}."],
               [f"fix-{attempt}.patch"] + ([f"check-on-fix-{attempt}.log"] if check else []),
               {"fix_rev": branch, "fix_sha": fix_sha, "attempts": attempts})
    feedback = f"\nYour previous patch built, but the regression check still fails:\n{(JOB / f'check-on-fix-{attempt}.log').read_text()[-1200:]}\nFix the cause."
finish(f"No working fix in 2 attempts", [f"Two fix attempts failed: {[{k: a[k] for k in a if k != 'reasoning'} for a in attempts]}"],
       [f"fix-{a['attempt']}.patch" for a in attempts], {"attempts": attempts})
