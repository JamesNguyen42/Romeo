# Case service settings on the GB10. No secrets here.
ROMEO_PORT=8790
ROMEO_DATA=/opt/hack/data
ROMEO_CASES=/opt/hack/Romeo/cases/cases.json
ROMEO_TOOLS=/opt/hack/Romeo/tools
ROMEO_DASHBOARD=/opt/hack/Romeo/dashboard
ROMEO_UI=/opt/hack/Romeo/ui/dist
ROMEO_RENDER=/opt/hack/Romeo/build/romeo-render
ROMEO_REPO_DIR=/opt/hack/product/renderer
ROMEO_FRAMES=600
ROMEO_THINK=1
CLEF_URL=http://127.0.0.1:8001/v1/systemone
ORNITH_URL=http://127.0.0.1:8000/v1/chat/completions
ORNITH_METRICS=http://127.0.0.1:8000/metrics
MEMORY_URL=http://127.0.0.1:8791/similar
PRODUCT_DIR=/opt/hack/product
PRODUCT_REPO=Cosmin-B/romeo-renderer
ROMEO_BUILDS=/opt/hack/builds
ROMEO_MAX_ACTIVE=3
